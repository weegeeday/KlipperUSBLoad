# Add these sections to ~/printer_data/config/moonraker.conf

[klipper_usb_load]
# Physical USB port allowlist (comma-separated). Leave empty to allow all USB ports.
# When a drive is plugged into an unlisted port, the LCD and moonraker.log report its port ID.
# Example:
# allowed_ports: 1-1.1, 1-1.2
allowed_ports:
max_scan_depth: 2
wait_for_metadata: True
sync_timeout_seconds: 60
gcode_extensions: .gcode, .gco, .g
lcd_notifications: True
usb_subdir_name: usb

[update_manager klipper_usb_load]
type: git_repo
channel: dev
path: ~/KlipperUSBLoad
origin: https://github.com/weegeeday/KlipperUSBLoad.git
primary_branch: main
managed_services: moonraker
install_script: install.sh
